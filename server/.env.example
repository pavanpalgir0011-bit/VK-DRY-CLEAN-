PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vkdryclean
JWT_SECRET=your_secure_jwt_secret_token_here
CLIENT_URL=http://localhost:5173

# Admin Portal Credentials
ADMIN_NAME=Vikas
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Supabase PostgreSQL Database (Optional / Connected)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=https://[PROJECT-ID].supabase.co

# Firebase Configuration & Authentication
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Admin Order Email Notification (Gmail SMTP App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com
